{
  "_meta": {
    "file": "content-plan.schema.json",
    "purpose": "Validate the model-facing content plan used before generating living-document files."
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-document-forge.local/schemas/content-plan.schema.json",
  "title": "Living Document Content Plan",
  "type": "object",
  "required": ["document", "sections"],
  "properties": {
    "document": {
      "type": "object",
      "required": ["documentId", "title", "subtitle", "thesis", "audience", "status"],
      "properties": {
        "documentId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "thesis": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "index", "title", "deck", "source", "tags", "status", "estimatedMinutes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "index": { "type": "string" },
          "title": { "type": "string" },
          "deck": { "type": "string" },
          "source": { "type": "string", "pattern": "^content/sections/.+\\.md$" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "estimatedMinutes": { "type": "integer", "minimum": 1 },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "backlinks": { "type": "array", "items": { "type": "string" } },
          "markdownSummary": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "modelReplies": { "type": "array" },
    "resources": { "type": "array" },
    "annotations": { "type": "array" }
  },
  "additionalProperties": true
}
