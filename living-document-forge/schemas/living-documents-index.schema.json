{
  "_meta": {
    "file": "living-documents-index.schema.json",
    "purpose": "Validate a central living-documents registry."
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-document-forge.local/schemas/living-documents-index.schema.json",
  "title": "Living Documents Registry",
  "type": "object",
  "required": ["registry", "documents"],
  "properties": {
    "registry": {
      "type": "object",
      "required": ["id", "title", "updated", "owner", "targetFormatVersion", "targetSkillVersion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "updated": { "type": "string" },
        "owner": { "type": "string" },
        "targetFormatVersion": { "type": "string" },
        "targetSkillVersion": { "type": "string" }
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["documentId", "title", "root", "manifest", "contentVersion", "formatVersion", "skillRange", "status", "owner", "tags", "lastValidation"],
        "properties": {
          "documentId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string" },
          "root": { "type": "string" },
          "entry": { "type": "string" },
          "modelEntry": { "type": "string" },
          "manifest": { "type": "string" },
          "contentVersion": { "type": "string" },
          "formatVersion": { "type": "string" },
          "skillRange": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {
              "min": { "type": "string" },
              "max": { "type": "string" }
            },
            "additionalProperties": false
          },
          "status": { "enum": ["active", "archived", "needs-migration", "blocked", "missing", "unknown"] },
          "owner": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "lastValidatedAt": { "type": ["string", "null"] },
          "lastValidation": { "enum": ["passed", "failed", "unvalidated", "skipped"] },
          "lastMigration": { "type": ["object", "null"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
