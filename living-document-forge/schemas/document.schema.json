{
  "_meta": {
    "file": "document.schema.json",
    "purpose": "Validate living-document format 2.1 manifests."
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-document-forge.local/schemas/document.schema.json",
  "title": "Living Document Manifest",
  "type": "object",
  "required": ["meta", "navigation", "dashboard", "sections", "proposals", "releases", "history", "visual", "worklogs"],
  "properties": {
    "_meta": { "type": "object" },
    "meta": {
      "type": "object",
      "required": ["documentId", "title", "subtitle", "version", "updated", "status", "thesis", "audience", "compatibility"],
      "properties": {
        "documentId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
        "updated": { "type": "string", "format": "date" },
        "status": { "type": "string", "minLength": 1 },
        "thesis": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "compatibility": {
          "type": "object",
          "required": ["formatVersion", "skillRange"],
          "properties": {
            "formatVersion": { "const": "2.1.0" },
            "skillRange": {
              "type": "object",
              "required": ["min", "max"],
              "properties": {
                "min": { "type": "string" },
                "max": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "navigation": {
      "type": "object",
      "required": ["defaultView", "sectionOrder", "quickFilters", "showInspector", "showReadingProgress"],
      "properties": {
        "defaultView": { "enum": ["dashboard", "document", "history", "changelog", "search"] },
        "sectionOrder": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "quickFilters": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "showInspector": { "type": "boolean" },
        "showReadingProgress": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "dashboard": {
      "type": "object",
      "required": ["focus", "health", "metricDefinitions", "pinnedSectionIds", "decisionQueueLimit"],
      "properties": {
        "focus": { "type": "string", "minLength": 1 },
        "health": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "state", "detail"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "state": { "enum": ["good", "attention", "blocked"] },
              "detail": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "metricDefinitions": { "type": "array", "items": { "type": "object" } },
        "pinnedSectionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "decisionQueueLimit": { "type": "integer", "minimum": 1, "maximum": 50 }
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    },
    "proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "releases": {
      "type": "array",
      "items": { "$ref": "#/$defs/release" }
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/historyEvent" }
    },
    "visual": {
      "type": "object",
      "required": ["defaultTheme", "themes", "defaultMotion", "density", "designDirection"],
      "properties": {
        "defaultTheme": { "type": "string" },
        "themes": { "type": "array", "items": { "type": "string" }, "minItems": 2, "uniqueItems": true },
        "defaultMotion": { "enum": ["system", "full", "reduced"] },
        "density": { "enum": ["comfortable", "compact"] },
        "designDirection": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "worklogs": {
      "type": "array",
      "items": { "$ref": "#/$defs/worklog" }
    },
    "modelReplies": {
      "type": "array",
      "items": { "$ref": "#/$defs/modelReply" }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "required": ["id", "index", "eyebrow", "title", "dek", "source", "tags", "status", "editable", "updated", "estimatedMinutes", "dependencies", "backlinks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "index": { "type": "string" },
        "eyebrow": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "dek": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "pattern": "^content/sections/.+\\.md$" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "status": { "enum": ["draft", "active", "review", "stable", "deprecated", "archived"] },
        "editable": { "type": "boolean" },
        "owner": { "type": "string" },
        "updated": { "type": "string", "format": "date" },
        "estimatedMinutes": { "type": "integer", "minimum": 1 },
        "dependencies": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "backlinks": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "proposal": {
      "type": "object",
      "required": ["id", "title", "summary", "impact", "effort", "decision", "targetIds", "tags", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "impact": { "enum": ["low", "medium", "high"] },
        "effort": { "enum": ["low", "medium", "high"] },
        "decision": { "enum": ["proposed", "approve", "defer", "reject", "implemented"] },
        "targetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "required": ["version", "date", "title", "summary", "changes"],
      "properties": {
        "version": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "text", "targetIds"],
            "properties": {
              "type": { "enum": ["added", "changed", "fixed", "removed", "security", "research"] },
              "text": { "type": "string" },
              "targetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": true
    },
    "historyEvent": {
      "type": "object",
      "required": ["id", "timestamp", "actor", "kind", "summary", "targetIds", "version", "source"],
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "actor": { "type": "string" },
        "kind": { "type": "string" },
        "summary": { "type": "string" },
        "targetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "version": { "type": "string" },
        "source": { "enum": ["human", "agent", "system", "import", "local"] },
        "details": { "type": "string" }
      },
      "additionalProperties": true
    },
    "worklog": {
      "type": "object",
      "required": ["id", "version", "date", "agent", "summary", "changed", "validated", "suggested", "warnings"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "agent": { "type": "string" },
        "summary": { "type": "string" },
        "changed": { "type": "array", "items": { "type": "string" } },
        "validated": { "type": "array", "items": { "type": "string" } },
        "suggested": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "modelReply": {
      "type": "object",
      "required": ["id", "prompt", "targetIds", "status", "options", "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "prompt": { "type": "string", "minLength": 1 },
        "context": { "type": "string" },
        "targetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "status": { "enum": ["open", "answered", "blocked", "resolved"] },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "text"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "text": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "resource": {
      "type": "object",
      "required": ["id", "title", "kind", "targetIds", "description", "status", "createdAt"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "enum": ["image", "video", "audio", "document", "data", "archive", "binary", "link", "other"] },
        "path": { "type": "string" },
        "url": { "type": "string" },
        "originalName": { "type": "string" },
        "mimeType": { "type": "string" },
        "extension": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "targetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "description": { "type": "string" },
        "status": { "enum": ["referenced", "available", "missing", "archived", "unsafe"] },
        "createdAt": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
