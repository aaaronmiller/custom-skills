#!/usr/bin/env python3
"""Living Document Forge entrypoint: resolve, create, register, and roll monthly documents."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import date, datetime, timezone
from pathlib import Path

SKILL_VERSION = "1.3.0"
FORMAT_VERSION = "2.1.0"


def kebab(value: str) -> str:
    value = value.lower().strip()
    value = re.sub(r"[^a-z0-9]+", "-", value)
    return value.strip("-") or "project"


def month_value(raw: str | None) -> str:
    value = raw or os.environ.get("LD_NOW") or date.today().strftime("%Y-%m")
    if not re.fullmatch(r"\d{4}-(0[1-9]|1[0-2])", value):
        raise ValueError(f"invalid month {value!r}; expected YYYY-MM")
    return value


def iso_day(month: str) -> str:
    today = date.today().isoformat()
    return today if today.startswith(month) else f"{month}-01"


def iso_now(month: str) -> str:
    override = os.environ.get("LD_TIMESTAMP")
    if override:
        return override
    if date.today().isoformat().startswith(month):
        return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")
    return f"{month}-01T00:00:00Z"


def find_git_root(start: Path) -> Path | None:
    current = start.resolve()
    for candidate in (current, *current.parents):
        if (candidate / ".git").exists():
            return candidate
    return None


def atomic_json(path: Path, data: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            json.dump(data, stream, indent=2, ensure_ascii=False)
            stream.write("\n")
        os.replace(temp_name, path)
    finally:
        if os.path.exists(temp_name):
            os.unlink(temp_name)


def load_json(path: Path) -> dict:
    with path.open(encoding="utf-8") as stream:
        value = json.load(stream)
    if not isinstance(value, dict):
        raise ValueError(f"expected object in {path}")
    return value


def resolve_skill_root() -> Path:
    override = os.environ.get("LD_SKILL_ROOT")
    return Path(override).expanduser().resolve() if override else Path(__file__).resolve().parent.parent


def resolve_home(raw: str | None) -> Path:
    value = raw or os.environ.get("LD_HOME") or "~/code/living-documents"
    return Path(value).expanduser().resolve()


def resolve_scope(args: argparse.Namespace) -> tuple[str, Path | None]:
    cwd = Path(args.project or os.environ.get("LD_PROJECT_ROOT") or os.getcwd()).expanduser().resolve()
    project_root = find_git_root(cwd)
    if args.scope == "universal":
        return "universal", None
    if args.scope == "project":
        return "project", project_root or cwd
    if args.project or os.environ.get("LD_PROJECT_ROOT") or project_root:
        return "project", project_root or cwd
    return "universal", None


def paths_for(scope: str, project_root: Path | None, home: Path, month: str) -> tuple[Path, Path]:
    if scope == "universal":
        base = home / "universal"
    else:
        assert project_root is not None
        base = project_root / ".living-documents"
    return base, base / f"{month}.livingdoc"


def read_pointer(base: Path) -> dict | None:
    pointer = base / "current.json"
    return load_json(pointer) if pointer.exists() else None


def build_manifest(target: Path, title: str, document_id: str, scope: str, month: str,
                   project_root: Path | None, previous: dict | None) -> dict:
    manifest_path = target / "public/content/index.json"
    manifest = load_json(manifest_path)
    day = iso_day(month)
    stamp = iso_now(month)
    meta = manifest["meta"]
    meta.update({
        "documentId": document_id,
        "title": title,
        "subtitle": f"The active {month} {scope} living document.",
        "updated": day,
        "thesis": "Preserve current intent, verified progress, decisions, unresolved questions, and the next safe action for this monthly workstream.",
        "audience": "The human operator and agents continuing this workstream.",
        "scope": scope,
        "month": month,
        "seriesId": "universal" if scope == "universal" else f"project-{kebab(project_root.name if project_root else 'project')}",
        "projectRoot": str(project_root) if project_root else None,
    })
    manifest["dashboard"]["focus"] = "Record the current objective, verified state, decisions, blockers, and next safe action."
    manifest["history"][0].update({
        "timestamp": stamp,
        "summary": f"Created the {month} {scope} living document.",
        "details": "Created by the ld entrypoint from the canonical Living Document Forge template.",
    })
    manifest["worklogs"][0].update({
        "date": day,
        "agent": "ld",
        "summary": f"Initialized the {month} {scope} living document.",
    })
    manifest["releases"][0].update({
        "date": day,
        "title": f"{month} document initialized",
        "summary": f"Created the active {scope} living-document surface for {month}.",
    })
    if previous:
        manifest["meta"]["continuity"] = {
            "previousDocumentId": previous.get("documentId"),
            "previousRoot": previous.get("root"),
            "rolledOverAt": stamp,
        }
        manifest["history"].append({
            "id": "H-0002",
            "timestamp": stamp,
            "actor": "ld",
            "kind": "rollover",
            "summary": f"Rolled forward from {previous.get('month', 'the previous month')}.",
            "targetIds": ["document"],
            "version": "1.0.0",
            "source": "system",
            "details": f"Previous document: {previous.get('root')}",
        })
        manifest["worklogs"].append({
            "id": "W-0002",
            "version": "1.0.0",
            "date": day,
            "agent": "ld",
            "summary": "Recorded monthly continuity without mutating the previous document.",
            "changed": ["Added previous-document continuity metadata"],
            "validated": ["Previous pointer parsed", "New monthly target created"],
            "suggested": ["Carry forward only still-active decisions and blockers"],
            "warnings": [],
        })
    atomic_json(manifest_path, manifest)
    return manifest


def scaffold(target: Path, title: str, document_id: str, scope: str, month: str,
             project_root: Path | None, previous: dict | None, skill_root: Path) -> dict:
    app = skill_root / "templates/app"
    content = skill_root / "templates/blank-content"
    if not app.is_dir() or not content.is_dir():
        raise FileNotFoundError(f"incomplete skill package at {skill_root}")
    if target.exists() and any(target.iterdir()):
        raise FileExistsError(f"refusing non-empty target: {target}")
    target.mkdir(parents=True, exist_ok=True)
    shutil.copytree(app, target, dirs_exist_ok=True)
    shutil.copytree(content, target, dirs_exist_ok=True)
    return build_manifest(target, title, document_id, scope, month, project_root, previous)


def validate_document(target: Path, skill_root: Path) -> str:
    validator = skill_root / "scripts/validate-living-document.mjs"
    completed = subprocess.run(
        ["node", str(validator), str(target)],
        text=True,
        capture_output=True,
    )
    if completed.returncode != 0:
        detail = completed.stderr.strip() or completed.stdout.strip() or "unknown validation error"
        raise ValueError(f"generated document failed validation: {detail}")
    return completed.stdout.strip()


def registry_template(home: Path) -> dict:
    return {
        "_meta": {
            "file": "living-documents-index.json",
            "purpose": "Central registry for locating and migrating living documents.",
            "schema": "living-documents-index-1.0.0",
        },
        "registry": {
            "id": "workspace-living-documents",
            "title": "Living Documents Registry",
            "updated": date.today().isoformat(),
            "owner": os.environ.get("USER", "Document steward"),
            "targetFormatVersion": FORMAT_VERSION,
            "targetSkillVersion": SKILL_VERSION,
        },
        "documents": [],
    }


def update_registry(home: Path, record: dict, previous: dict | None, dry_run: bool) -> None:
    path = home / "living-documents-index.json"
    registry = load_json(path) if path.exists() else registry_template(home)
    registry["registry"]["updated"] = iso_day(record["month"])
    registry["registry"]["targetSkillVersion"] = SKILL_VERSION
    documents = registry.setdefault("documents", [])
    if previous:
        for item in documents:
            if item.get("documentId") == previous.get("documentId"):
                item["status"] = "archived"
                item["notes"] = f"Rolled over to {record['documentId']}"
    documents[:] = [item for item in documents if item.get("documentId") != record["documentId"]]
    documents.append(record)
    documents.sort(key=lambda item: (item.get("scope", ""), item.get("seriesId", ""), item.get("month", "")))
    if not dry_run:
        atomic_json(path, registry)


def ensure(args: argparse.Namespace) -> dict:
    month = month_value(args.month)
    home = resolve_home(args.home)
    scope, project_root = resolve_scope(args)
    base, target = paths_for(scope, project_root, home, month)
    pointer = read_pointer(base)
    previous = pointer if pointer and pointer.get("month") != month else None
    project_name = project_root.name if project_root else "Universal"
    title = args.title or (f"Universal Worklog — {month}" if scope == "universal" else f"{project_name} — {month}")
    document_id = f"universal-{month}" if scope == "universal" else f"{kebab(project_name)}-{month}"
    skill_root = resolve_skill_root()
    created = False
    if not target.exists():
        if not args.dry_run:
            scaffold(target, title, document_id, scope, month, project_root, previous, skill_root)
        created = True
    elif not (target / "public/content/index.json").exists():
        raise FileExistsError(f"target exists but is not a living document: {target}")

    validation_output = None
    if not args.dry_run:
        validation_output = validate_document(target, skill_root)

    record = {
        "documentId": document_id,
        "title": title,
        "root": str(target),
        "entry": str(target / "READER_START_HERE.html"),
        "modelEntry": str(target / "MODEL_START_HERE.md"),
        "manifest": str(target / "public/content/index.json"),
        "contentVersion": "1.0.0",
        "formatVersion": FORMAT_VERSION,
        "skillRange": {"min": "1.2.0", "max": "2.0.0"},
        "status": "active",
        "owner": os.environ.get("USER", "Document steward"),
        "tags": [scope, month],
        "lastValidatedAt": iso_now(month) if validation_output else None,
        "lastValidation": "passed" if validation_output else "unvalidated",
        "lastMigration": None,
        "notes": "Created and routed by ld.",
        "scope": scope,
        "seriesId": "universal" if scope == "universal" else f"project-{kebab(project_name)}",
        "month": month,
        "projectRoot": str(project_root) if project_root else None,
    }
    update_registry(home, record, previous, args.dry_run)
    if not args.dry_run:
        atomic_json(base / "current.json", record)
    return {
        "action": "created" if created else "existing",
        "scope": scope,
        "month": month,
        "root": str(target),
        "manifest": record["manifest"],
        "registry": str(home / "living-documents-index.json"),
        "rolledOverFrom": previous.get("root") if previous else None,
        "dryRun": args.dry_run,
        "validation": validation_output,
    }


def status(args: argparse.Namespace) -> dict:
    month = month_value(args.month)
    home = resolve_home(args.home)
    scope, project_root = resolve_scope(args)
    base, target = paths_for(scope, project_root, home, month)
    return {
        "scope": scope,
        "month": month,
        "expectedRoot": str(target),
        "exists": target.is_dir(),
        "current": read_pointer(base),
        "registry": str(home / "living-documents-index.json"),
    }


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="ld", description="Create or locate the current monthly living document.")
    sub = result.add_subparsers(dest="command")
    for name in ("ensure", "status"):
        item = sub.add_parser(name)
        item.add_argument("--scope", choices=("auto", "universal", "project"), default="auto")
        item.add_argument("--project", help="Project path; implies project routing in auto mode")
        item.add_argument("--home", help="Central living-documents repository")
        item.add_argument("--month", help="Target month in YYYY-MM")
        if name == "ensure":
            item.add_argument("--title")
            item.add_argument("--dry-run", action="store_true")
    return result


def main() -> int:
    argv = sys.argv[1:]
    if not argv or argv[0] not in {"ensure", "status", "-h", "--help"}:
        argv = ["ensure", *argv]
    args = parser().parse_args(argv)
    try:
        result = ensure(args) if args.command == "ensure" else status(args)
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as error:
        print(f"ld: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
