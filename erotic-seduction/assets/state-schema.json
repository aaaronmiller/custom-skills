{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Erotic Seduction Adaptive State",
  "type": "object",
  "required": [
    "schema_version",
    "tempo",
    "trajectory",
    "chemistry_level",
    "chemistry_confidence",
    "strategy_stats",
    "callbacks"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 4
    },
    "tempo": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trajectory": {
      "enum": [
        "orientation",
        "calibration",
        "reciprocal-play",
        "stable-chemistry",
        "saturation",
        "recalibration",
        "neutral"
      ]
    },
    "turn_count": {
      "type": "integer",
      "minimum": 0
    },
    "explicit_preferences": {
      "type": "object"
    },
    "learned_preferences": {
      "type": "object"
    },
    "preference_confidence": {
      "type": "object"
    },
    "persona": {
      "type": "object"
    },
    "strategy_stats": {
      "type": "object"
    },
    "callbacks": {
      "type": "array",
      "maxItems": 30
    },
    "chemistry_level": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "chemistry_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}
