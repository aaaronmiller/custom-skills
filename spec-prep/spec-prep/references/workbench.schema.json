{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:spec-prep:workbench:1",
  "title": "spec-prep workbench configuration",
  "type": "object",
  "required": ["schemaVersion", "kind", "intake", "mode", "artifacts", "additionalFiles", "integrations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "spec-prep-workbench"},
    "intake": {"const": "project-intake.json"},
    "mode": {"enum": ["auto", "on", "off"]},
    "buildRoot": {"type": "string", "minLength": 1},
    "additionalFiles": {"const": "discover"},
    "artifacts": {"type": "array", "items": {
      "type": "object", "required": ["role", "scope", "path", "use"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "scope": {"enum": ["intake", "build"]},
        "path": {"type": "string", "minLength": 1},
        "use": {"enum": ["source", "operational"]}
      }
    }},
    "integrations": {"type": "object", "required": ["livingDocuments"], "properties": {
      "livingDocuments": {"type": "object", "required": ["mode"], "properties": {
        "mode": {"enum": ["auto", "on", "off"]},
        "dossier": {"type": "string", "minLength": 1}
      }}
    }}
  }
}
